# First Twenty server settings: the production template.
# EC2: setup-ec2.sh copies this file to /etc/first-twenty/env (mode 600); edit it there with sudo.
# Local development needs no .env at all (the server falls back to PGlite, no Postgres needed). To work
# against the EC2 database through an SSH tunnel, create a git-ignored .env holding only the lines you
# change, for example DATABASE_URL=postgres://first_twenty:CHANGE_ME@127.0.0.1:5433/first_twenty
# (docs/SERVER.md, "Develop locally"). Never commit real values.
# Keep every comment on its own line: systemd does not strip a comment that follows a value, so
# "PORT=8787 # note" would make the port "8787 # note".

# Address the API listens on. Keep 127.0.0.1 in production: Caddy terminates HTTPS and proxies to it.
HOST=127.0.0.1

# Port the API listens on. Must match the reverse_proxy line in server/deploy/Caddyfile.
PORT=8787

# Postgres connection the server runs with: the first_twenty role made by server/deploy/postgres-setup.sql.
# It can read and write rows but cannot create, change or drop tables.
# Percent-encode special characters in the password (@ is %40, : is %3A, / is %2F, # is %23).
# A database on another host also needs its IP address in the service's IPAddressAllow= (docs/SERVER.md).
# Development without Postgres: DATABASE_URL=pglite:./.data/pg (also the default when unset in development).
DATABASE_URL=postgres://first_twenty:CHANGE_ME@127.0.0.1:5432/first_twenty

# Postgres connection for migrations only: the first_twenty_owner role, which owns the tables. Use a
# different password from DATABASE_URL. Read by server/deploy/with-env.sh for npm run server:migrate and
# server:after-restore (deploy.sh runs the first), and by backup.sh. The running server never sees it:
# the systemd unit unsets it.
MIGRATION_DATABASE_URL=postgres://first_twenty_owner:CHANGE_ME@127.0.0.1:5432/first_twenty

# TLS to Postgres. disable is right for 127.0.0.1 (traffic never leaves the instance); use verify-full for a remote database.
PGSSLMODE=disable

# The public HTTPS address people open (no trailing path). When it is https, the sign-in cookies are Secure
# __Host- cookies and HSTS is sent; requests that reach Caddy over https get them either way. Keep it in step
# with the domain in /etc/caddy/Caddyfile: re-running setup-ec2.sh with a new domain does not change it here.
PUBLIC_ORIGIN=https://hr.example.com

# Serve the one-file app at / (true on the server; false when the Vite dev server serves the app).
SERVE_APP=true

# Path to the built one-file app (made by npm run build), relative to the working directory /opt/first-twenty.
APP_FILE=first-twenty.html

# Apply pending SQL migrations when the server starts. Keep false in production: the server's role
# (DATABASE_URL) cannot change tables, so deploy.sh runs npm run server:migrate as first_twenty_owner.
MIGRATE_ON_START=false

# A sign-in ends after this many hours without activity.
SESSION_IDLE_HOURS=12

# A sign-in ends after this many days no matter what.
SESSION_MAX_DAYS=7

# Who may create a login. closed (the default): only server:create-admin and invite links make logins.
# open: a public demo server, where anyone can create a login and a demo company of their own. Never open
# a server that holds real data (docs/SERVER.md, "A public demo server").
SIGNUP_MODE=closed

# Optional, for SIGNUP_MODE=open. The most demo companies at once; sign-ups are refused beyond it.
# DEMO_MAX_WORKSPACES=500
# Days without a change or a sign-in after which a demo company is deleted with everything in it (0: never).
# A sign-up that never uploaded its company goes after a day. Your own workspace, the one
# server:create-admin signs in to, is never deleted.
# DEMO_EXPIRE_DAYS=30
# Megabytes of records the demo companies may hold together (each holds 16 MB at most). Writes past it are
# refused, so strangers can never fill the disk your own workspace lives on. Keep it well under the disk's
# free space: the change log and the nightly backups take about as much again.
# DEMO_MAX_TOTAL_MB=2048

# Optional. Host names that serve the companies' careers pages and nothing else, separated by commas, each
# with its own site block in /etc/caddy/Caddyfile. Empty: no careers pages.
# CAREERS_HOSTS=careers.example.com,jobs.example.com
# The address careers links are built on (default: https:// and the first of CAREERS_HOSTS).
# CAREERS_ORIGIN=https://careers.example.com

# Optional. The in-app assistant (Lark in the sample; docs/SERVER.md, "Lark, the assistant"). It is on only
# when ANTHROPIC_API_KEY holds a key from the Claude Console (console.anthropic.com, API keys). The key stays
# in this file and the server's memory: it is never logged, never sent to a browser. Each question and the
# records the assistant looks up for it go to Anthropic's Claude API. Set a monthly spend limit in the Console.
# ANTHROPIC_API_KEY=
# The model and how much it thinks (low, medium, high, xhigh or max), and the most each turn may write, its
# thinking included (an answer that reaches it is cut off, and the panel says so).
# ASSISTANT_MODEL=claude-opus-5-5
# ASSISTANT_EFFORT=low
# ASSISTANT_MAX_TOKENS=8000
# Messages a day (UTC): per company, and for every company together (its last quarter kept for companies
# that have asked fewer than 5 that day). They cap what the assistant can cost.
# ASSISTANT_DAILY_PER_WORKSPACE=40
# ASSISTANT_DAILY_GLOBAL=600
# Development only: 1 runs a scripted model instead of Claude (no key, nothing leaves the computer). The
# server refuses to start with it in production.
# ASSISTANT_FAKE=1

# Development only: lets a browser app on another origin call the API. The server refuses to start with it in production.
# ALLOWED_ORIGIN=http://127.0.0.1:8826

# Optional. Which proxies may set X-Forwarded-For (default loopback, which is Caddy on this instance).
# TRUST_PROXY=loopback

# Optional. Log detail: fatal, error, warn, info (default), debug. Logs never include bodies, cookies or passwords.
# LOG_LEVEL=info

# Read by server/deploy/backup.sh, not by the server. Uncomment to change the defaults.
# Where nightly dumps go (root only).
# BACKUP_DIR=/var/backups/first-twenty
# How many days of nightly dumps to keep on the instance.
# BACKUP_KEEP_DAYS=14
# Also copy each dump to S3 (needs the aws CLI and an instance role that can write to the bucket).
# BACKUP_S3_URI=s3://your-bucket-name/first-twenty/
# A specific pg_dump (it must be the database server's major version or newer).
# PG_DUMP=/usr/lib/postgresql/17/bin/pg_dump
# PG_RESTORE=/usr/lib/postgresql/17/bin/pg_restore
