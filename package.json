{
  "name": "first-twenty",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "type": "module",
  "description": "Lightweight ATS + HCM for a company's first twenty people. Browser-only, local-first.",
  "scripts": {
    "dev": "node --max-semi-space-size=64 node_modules/vite/bin/vite.js --port 8826 --strictPort --host 127.0.0.1",
    "build": "node --max-semi-space-size=64 node_modules/vite/bin/vite.js build --mode single && node scripts/copy-single.mjs",
    "build:careers": "tsx scripts/careers/build.ts --out dist-careers",
    "preview": "node --max-semi-space-size=64 node_modules/vite/bin/vite.js preview --port 8827 --strictPort",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p server",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm run build",
    "build:all": "npm run build && npm run server:build",
    "server:dev": "tsx watch --clear-screen=false server/src/index.ts",
    "server:build": "node --max-semi-space-size=64 node_modules/vite/bin/vite.js build --config vite.server.config.ts",
    "server:start": "node dist-server/server.mjs",
    "server:migrate": "node server/src/cli/run.mjs migrate",
    "server:create-admin": "node server/src/cli/run.mjs create-admin",
    "server:after-restore": "node server/src/cli/run.mjs after-restore",
    "server:gen-sql": "tsx server/src/cli/gen-sql.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@fastify/cookie": "^11.1.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "date-fns": "^4.4.0",
    "fastify": "^5.12.5",
    "immer": "^10.2.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
