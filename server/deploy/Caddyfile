# First Twenty: Caddy site for the API server and the app, and for the companies' careers pages.
# setup-ec2.sh renders this file to /etc/caddy/Caddyfile, replacing hr.example.com with your domain in
# both site blocks, writing the careers site at the end once per --careers-domain (or not at all), and
# turning on the tls email lines when you pass --email. To edit by hand:
#   sudo nano /etc/caddy/Caddyfile
#   sudo caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
#   sudo systemctl reload caddy
#
# Caddy gets and renews the HTTPS certificate on its own (ports 80 and 443 must be open) and redirects
# http:// to https://. The Node server listens only on 127.0.0.1:8787 and sets its own Content-Security-Policy.

# Global options. Caddy reads them only from the first block of the main Caddyfile, so when setup has to
# put the site in a file of its own (your own /etc/caddy/Caddyfile was left alone), it leaves this block
# out and asks you to add it to the top of yours.
{
	servers {
		# Caddy 2.6 sets no read timeouts, so a client sending its TLS handshake, headers or body a byte at a
		# time could hold a connection and its memory for good. read_header also bounds the TLS handshake.
		# read_body lets a 10 MB workspace upload through at about 0.5 Mbit/s (the server's own limit,
		# REQUEST_TIMEOUT_MS in server/src/app.ts, matches it). No write timeout: a slow download of the app
		# or of the workspace must not be cut off.
		timeouts {
			read_header 15s
			read_body 3m
			idle 2m
		}
		# HTTP/1.1 and HTTP/2 only. HTTP/3 would need UDP 443, which the security group keeps closed.
		protocols h1 h2
	}
}

# Plain http: only the redirect to https (Caddy answers its certificate challenges before any route).
# Written out rather than left to Caddy's automatic redirect, because the automatic one gets none of the
# server options above, timeouts included.
http://hr.example.com {
	redir https://{host}{uri} permanent
}

hr.example.com {
	# Contact email for certificate expiry notices (optional).
	# tls you@example.com

	encode zstd gzip

	# The server accepts bodies up to 10 MB (a full workspace upload); leave a little headroom.
	request_body {
		max_size 12MB
	}

	# HSTS on every proxied response, even if PUBLIC_ORIGIN in /etc/first-twenty/env was left at http://.
	# defer applies it after the server's own copy arrives and replaces that copy, so exactly one goes out.
	# The server sends its other security headers itself. (Caddy 2.6 applies "?" defaults in one header
	# block only when every one of them is missing, so they would never apply here.)
	header {
		Strict-Transport-Security "max-age=31536000"
		defer
	}
	header -Server

	reverse_proxy 127.0.0.1:8787 {
		# Caddy sends X-Forwarded-For and X-Forwarded-Proto; the server trusts them only from 127.0.0.1.
		header_up -X-Real-IP
	}

	# Access log without bodies; Caddy redacts Cookie and Set-Cookie headers by default. An invite token
	# is a key to a company until it is used, so it never reaches the log: the app sends it in a request
	# body, and the path form older apps use (GET /api/invites/<token>) is logged with the token cut out,
	# as the server's own log does (redactPath in server/src/app.ts).
	log {
		output file /var/log/caddy/first-twenty-access.log {
			roll_size 20MiB
			roll_keep 10
		}
		format filter {
			wrap json
			fields {
				request>uri regexp "(?i)/invites/[^/?#]+" "/invites/[redacted]"
			}
		}
	}
}

# Careers pages (CAREERS_HOSTS in /etc/first-twenty/env; docs/SERVER.md, "Careers pages"). setup-ec2.sh
# writes the template between the BEGIN and END lines once per --careers-domain, with careers.example.com
# replaced, and leaves it out when there is none. Each careers host proxies to the same server, which
# answers only careers pages there. Its HSTS covers that host alone (no includeSubDomains, here or on the
# app's site), and it never carries a cookie: the app's cookies are __Host- cookies of the app's host, and
# this site drops any Set-Cookie on the way out.
# BEGIN careers site
http://careers.example.com {
	redir https://{host}{uri} permanent
}

careers.example.com {
	# tls you@example.com

	encode zstd gzip

	# An application is a few KB (the server takes 32 KB at most); nothing here needs more.
	request_body {
		max_size 64KB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		defer
	}
	header -Server
	header -Set-Cookie

	reverse_proxy 127.0.0.1:8787 {
		header_up -X-Real-IP
	}

	log {
		output file /var/log/caddy/first-twenty-access.log {
			roll_size 20MiB
			roll_keep 10
		}
		format json
	}
}
# END careers site
